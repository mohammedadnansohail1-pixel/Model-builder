# Database
DATABASE_URL=postgresql://universaltune:universaltune@localhost:5432/universaltune
REDIS_URL=redis://localhost:6379/0

# Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=universaltune

# ML
HUGGINGFACE_TOKEN=hf_xxxxx
WANDB_API_KEY=xxxxx

# Security
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth
OAUTH_GOOGLE_CLIENT_ID=xxxxx
OAUTH_GOOGLE_CLIENT_SECRET=xxxxx
OAUTH_GITHUB_CLIENT_ID=xxxxx
OAUTH_GITHUB_CLIENT_SECRET=xxxxx

# Monitoring
SENTRY_DSN=xxxxx

# Application
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_V1_PREFIX=/api/v1
PROJECT_NAME=UniversalTune

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Environment
ENVIRONMENT=development
